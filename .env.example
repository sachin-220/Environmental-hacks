# SAMEER Environment Configuration
# Mode: live | demo
SAMEER_MODE=demo

# NASA FIRMS (Fire Information for Resource Management System) MAP KEY
# Get your key at: https://firms.modaps.eosdis.nasa.gov/api/map_key
FIRMS_MAP_KEY=YOUR_FIRMS_KEY

# OpenAQ API Key (v3 API)
# Get your key at: https://explore.openaq.org/
OPENAQ_API_KEY=YOUR_OPENAQ_KEY

# Copernicus Climate Data Store (CDS) API Key
# Format: <UID>:<API-Key> or new CDS portal personal access token
# Get your key at: https://cds.climate.copernicus.eu/
CDS_API_KEY=YOUR_COPERNICUS_KEY

# Log Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
SAMEER_LOG_LEVEL=INFO

# Google Maps API Key (Optional: for Google Maps spatial engine in dashboard)
# Get your key at: https://console.cloud.google.com/google/maps-apis
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

